# Copy this file to .env and replace every placeholder.  .env is ignored by Git.
APP_ENV=production
DEV_AUTH_BYPASS=false
SECURE_COOKIE=true
SECRET_KEY=replace-with-a-long-random-secret
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
# Limit for uploads stored and indexed on this computer.
PDF_UPLOAD_MAX_MB=25
