# ==============================================================================
# Medflow Medical RAG - Production Environment Configuration Template
# Copy this file to .env or set inside Hugging Face Space Secrets.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=production

# Server Port (automatically provided by Hugging Face Spaces: 7860)
PORT=7860

# Persistent Data Storage Directory
DATA_DIR=/app/data

# JWT Authentication Secret Key (Set a random 32+ character string in Space Secrets)
SECRET_KEY=set_your_random_secret_key_in_space_secrets

# Cookie Security (Set to true over public HTTPS)
SECURE_COOKIE=true

# Initial Admin Account Credentials (Optional: Set in Hugging Face Space Secrets)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_here

# Optional: Groq LLM API Key
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
