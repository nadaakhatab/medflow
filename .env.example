# ==============================================================================
# Medflow Medical RAG - Production Environment Configuration Template
# Copy this file to .env and set your custom secrets before deployment.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=production

# Server Port (automatically provided by cloud platforms like Render / Railway / Cloud Run)
PORT=8000

# Persistent Data Storage Directory (for SQLite DB, ChromaDB vectors, and uploaded PDFs)
DATA_DIR=/app/data

# JWT Authentication Secret Key (Generate a random 32+ character string in production)
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_2026

# Cookie Security (Set to true when running over public HTTPS)
SECURE_COOKIE=true

# Initial Admin Account Credentials (Seeded on first startup)
INITIAL_ADMIN_EMAIL=medflow@gmail.com
INITIAL_ADMIN_PASSWORD=medflow@2026

# Optional: Groq LLM API Key (for Day 3+ dynamic generative LLM synthesis if enabled)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
