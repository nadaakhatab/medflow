# Copy this file to .env and fill your own credentials.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Day 3 starts with an illustrative threshold. Day 4 writes the measured threshold
# after calibration; do not present 0.50 as a scientifically calibrated value.
CONFIDENCE_THRESHOLD=0.50

